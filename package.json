{
  "name": "bookreader-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Локальная читалка английских книг с построчным переводом, словарём, повторением и озвучкой",
  "scripts": {
    "start": "npm run build && node server/index.js",
    "serve": "node server/index.js",
    "dev": "concurrently -k -n server,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "compromise": "^14.19.0",
    "fastify": "^5.12.7",
    "htmlparser2": "^12.0.0",
    "jszip": "^3.10.2",
    "kokoro-js": "^1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
